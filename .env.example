# Environment Configuration for Urban Drain Monitor
# Note: For Vercel hosting, configure these environment variables in:
# Vercel Project Dashboard -> Settings -> Environment Variables

# Node & Server Environment
NODE_ENV=production
PORT=3000

# MongoDB Atlas Connection
# IMPORTANT: In MongoDB Atlas -> Network Access, ensure 0.0.0.0/0 is whitelisted
# so dynamic Vercel Serverless Function IP addresses can connect.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.wwcm8vl.mongodb.net/urban_drain_monitor?retryWrites=true&w=majority
MONGODB_DB_NAME=urban_drain_monitor

# Authentication & Session Security
JWT_SECRET=super_secret_jwt_key_urban_drain_2026_academic_lab
JWT_EXPIRES_IN=7d

# File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# AI & Spatial Risk Engine Parameters
GEO_CLUSTER_RADIUS_METERS=800
RISK_TIME_WINDOW_HOURS=72
DUPLICATE_DISTANCE_METERS=100
DUPLICATE_TIME_WINDOW_HOURS=24

# Optional: Default Initial Administrator Bootstrap
ADMIN_EMAIL=admin@citydrain.gov.in
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Municipal Admin Officer

