{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": "client",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/citizen-dashboard",
      "destination": "/citizen-dashboard.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/admin-dashboard.html"
    },
    {
      "source": "/maintenance-dashboard",
      "destination": "/maintenance-dashboard.html"
    },
    {
      "source": "/report-problem",
      "destination": "/report-problem.html"
    },
    {
      "source": "/report-details",
      "destination": "/report-details.html"
    },
    {
      "source": "/my-reports",
      "destination": "/my-reports.html"
    },
    {
      "source": "/manage-reports",
      "destination": "/manage-reports.html"
    },
    {
      "source": "/manage-teams",
      "destination": "/manage-teams.html"
    },
    {
      "source": "/hotspots",
      "destination": "/hotspots.html"
    },
    {
      "source": "/risk-map",
      "destination": "/risk-map.html"
    },
    {
      "source": "/notifications",
      "destination": "/notifications.html"
    },
    {
      "source": "/prevention-insights",
      "destination": "/prevention-insights.html"
    },
    {
      "source": "/sustainability",
      "destination": "/sustainability.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    }
  ]
}
