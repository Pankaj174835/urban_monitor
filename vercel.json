{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "client/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/",
      "destination": "/client/index.html"
    },
    {
      "source": "/index",
      "destination": "/client/index.html"
    },
    {
      "source": "/login",
      "destination": "/client/login.html"
    },
    {
      "source": "/register",
      "destination": "/client/register.html"
    },
    {
      "source": "/citizen-dashboard",
      "destination": "/client/citizen-dashboard.html"
    },
    {
      "source": "/admin-dashboard",
      "destination": "/client/admin-dashboard.html"
    },
    {
      "source": "/maintenance-dashboard",
      "destination": "/client/maintenance-dashboard.html"
    },
    {
      "source": "/report-problem",
      "destination": "/client/report-problem.html"
    },
    {
      "source": "/report-details",
      "destination": "/client/report-details.html"
    },
    {
      "source": "/my-reports",
      "destination": "/client/my-reports.html"
    },
    {
      "source": "/manage-reports",
      "destination": "/client/manage-reports.html"
    },
    {
      "source": "/manage-teams",
      "destination": "/client/manage-teams.html"
    },
    {
      "source": "/hotspots",
      "destination": "/client/hotspots.html"
    },
    {
      "source": "/risk-map",
      "destination": "/client/risk-map.html"
    },
    {
      "source": "/notifications",
      "destination": "/client/notifications.html"
    },
    {
      "source": "/prevention-insights",
      "destination": "/client/prevention-insights.html"
    },
    {
      "source": "/sustainability",
      "destination": "/client/sustainability.html"
    },
    {
      "source": "/about",
      "destination": "/client/about.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/client/$1"
    }
  ]
}

